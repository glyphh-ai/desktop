{
  "compilerOptions": {
    "target": "ES2023",
    "module": "commonjs",
    "lib": [
      "ES2023"
    ],
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "paths": {
      "@glyphh/client/runtime": ["./node_modules/@glyphh/client/dist/runtime.d.ts"]
    },
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src/renderer/renderer.ts",
    "src/renderer/app-window.ts",
    "src/renderer/layout-window.ts",
    "src/renderer/help/**",
    "src/renderer/home.ts",
    "src/renderer/onboarding.ts",
    "src/renderer/terminal-renderer.ts",
    "src/renderer/downloads-ui.ts",
    "src/renderer/drip-ui.ts",
    "src/renderer/boot-gate-ui.ts",
    "src/renderer/tab-bar-ui.ts",
    "src/renderer/grid-ui.ts",
    "src/renderer/command-center-ui.ts",
    "src/renderer/yo-modal.ts",
    "src/renderer/search-clear.ts",
    "src/renderer/tsconfig.json"
  ]
}
