{
  "name": "@glyphh/sdk",
  "version": "1.3.0",
  "description": "The Glyphh client SDK \u2014 one library every client (mobile, desktop, CLI, web, platform) uses to authenticate and talk to the control plane + rotor runtime.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "bin": {
    "glyphh-sdk": "dist/cli.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./dist/index.js",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./storage/memory": {
      "types": "./dist/storage/memory.d.ts",
      "import": "./dist/storage/memory.js",
      "require": "./dist/storage/memory.cjs"
    },
    "./storage/file": {
      "types": "./dist/storage/file.d.ts",
      "import": "./dist/storage/file.js",
      "require": "./dist/storage/file.cjs"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js",
      "require": "./dist/runtime.cjs"
    },
    "./models": {
      "types": "./dist/models.d.ts",
      "import": "./dist/models.js",
      "require": "./dist/models.cjs"
    },
    "./machine": {
      "types": "./dist/machine.d.ts",
      "import": "./dist/machine.js",
      "require": "./dist/machine.cjs"
    },
    "./loop": {
      "types": "./dist/loop.d.ts",
      "import": "./dist/loop.js",
      "require": "./dist/loop.cjs"
    },
    "./router": {
      "types": "./dist/router.d.ts",
      "import": "./dist/router.js",
      "require": "./dist/router.cjs"
    },
    "./slides": {
      "types": "./dist/slides.d.ts",
      "react-native": "./dist/slides.js",
      "import": "./dist/slides.js",
      "require": "./dist/slides.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "repl": "tsx scripts/repl.ts",
    "cli": "tsx scripts/cli.ts",
    "verify": "npm run typecheck && npm run lint && npm run test",
    "gen:app-template": "node scripts/gen-app-template.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.20.0",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.9.0",
    "pg": "^8.22.0",
    "tsup": "^8.3.0",
    "tsx": "^4.23.1",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.8.0",
    "vitest": "^2.1.9"
  }
}
