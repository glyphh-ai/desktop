{
  "name": "glyphh-apps",
  "private": true,
  "productName": "Glyphh Desktop",
  "version": "2.2.3-beta",
  "description": "Glyphh Desktop — Your AI workspace.",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "npm run build && ELECTRON_RUN_AS_NODE= electron .",
    "build": "node scripts/check-ipc-registered.mjs && npm run build:main && npm run build:renderer && npm run build:skill-flow && npm run build:code-workbench && npm run build:monaco && npm run build:app-libs",
    "build:code-workbench": "esbuild src/renderer/code-workbench.ts --bundle --outfile=dist/renderer/code-workbench-bundle.js --platform=browser && esbuild src/renderer/pdf-raster.ts --bundle --outfile=dist/renderer/pdf-raster.js --platform=browser --format=iife && esbuild node_modules/pdfjs-dist/build/pdf.worker.mjs --bundle --outfile=dist/renderer/pdf-raster-worker.js --platform=browser --format=esm --minify && shx cp src/renderer/pdf-raster.html dist/renderer/",
    "build:main": "rm -rf dist/main && tsc",
    "build:app-libs": "node scripts/build-app-libs.mjs",
    "pack:apps": "node scripts/pack-apps.mjs",
    "build:skill-flow": "esbuild src/renderer/skill-flow.tsx --bundle --outfile=dist/renderer/skill-flow.js --platform=browser --format=iife --jsx=automatic --loader:.css=css",
    "build:renderer": "tsc -p src/renderer/tsconfig.json && shx cp src/renderer/styles.css src/renderer/browser.html src/renderer/thinking.html node_modules/@xterm/xterm/css/xterm.css dist/renderer/ && shx cp -r src/renderer/fonts dist/renderer/ && shx cp -r src/renderer/brand dist/renderer/ && node scripts/assemble-home.mjs",
    "build:monaco": "shx cp -r node_modules/monaco-editor/min/vs dist/renderer/monaco",
    "bench:code-index": "npm run build:main && node dist/main/code-index/benchmark.js",
    "bench:code-index-ab": "npm run build:main && node dist/main/code-index/benchmark-ab.js",
    "start": "electron .",
    "clean:local": "bash scripts/clean-local.sh",
    "postinstall": "electron-rebuild",
    "package:mac": "electron-builder --mac",
    "package:win": "electron-builder --win",
    "test:harness": "npm run build && electron test/harness/run-harness.mjs",
    "test:harness:fast": "electron test/harness/run-harness.mjs",
    "test": "vitest run",
    "package:linux": "electron-builder --linux"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/glyphh-ai/app.git"
  },
  "author": "Glyphh AI",
  "license": "LicenseRef-Proprietary",
  "devDependencies": {
    "@electron/rebuild": "^3.7.0",
    "@types/adm-zip": "^0.5.8",
    "@types/better-sqlite3": "^7.6.13",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.19.17",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.1",
    "@types/ws": "^8.18.1",
    "electron": "^42.5.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "shx": "^0.4.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "@glyphh/sdk": "file:../sdk",
    "@google/genai": "^2.10.0",
    "@huggingface/transformers": "^4.1.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/cytoscape": "^3.21.9",
    "@xterm/addon-canvas": "^0.7.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "@xyflow/react": "^12.10.2",
    "adm-zip": "^0.6.0",
    "better-sqlite3": "^12.11.1",
    "chart.js": "^4.5.1",
    "cytoscape": "^3.33.3",
    "cytoscape-dagre": "^2.5.0",
    "dagre": "^0.8.5",
    "dompurify": "^3.4.13",
    "dotenv": "^17.4.2",
    "electron-updater": "^6.8.9",
    "js-yaml": "^4.1.1",
    "kuzu": "^0.11.3",
    "marked": "^14.0.0",
    "monaco-editor": "^0.55.1",
    "node-cron": "^4.2.1",
    "node-pty": "^1.0.0",
    "onnxruntime-node": "^1.24.3",
    "openai": "^6.45.0",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "three": "^0.184.0",
    "ws": "^8.21.0",
    "zod": "^4.3.6"
  },
  "overrides": {
    "monaco-editor": {
      "dompurify": "^3.4.13"
    },
    "nanoid": "^3.3.18",
    "tar": "^7.5.22",
    "sharp": "^0.35.3",
    "fast-uri": "^3.1.4",
    "body-parser": "^2.3.0",
    "adm-zip": "^0.6.0",
    "brace-expansion": "^5.0.8",
    "@hono/node-server": "^2.0.5"
  },
  "optionalDependencies": {
    "ffmpeg-static": "^5.2.0",
    "werift": "^0.24.3"
  }
}
