{
  "name": "glyphh-apps",
  "private": true,
  "productName": "Glyphh Desktop",
  "version": "2.2.2",
  "description": "Glyphh Desktop — Your AI workspace.",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "WILLIAM_TRAINING_CAPTURE=1 npm run build && ELECTRON_RUN_AS_NODE= electron .",
    "build": "node scripts/check-ipc-registered.mjs && npm run build:helper && npm run build:main && npm run build:renderer && npm run build:skill-flow && npm run build:terminal && npm run build:code-workbench && npm run build:monaco && npm run build:app-libs",
    "build:helper": "bash scripts/build-mac-helper.sh",
    "build:code-workbench": "esbuild src/renderer/code-workbench.ts --bundle --outfile=dist/renderer/code-workbench-bundle.js --platform=browser",
    "build:main": "tsc",
    "build:app-libs": "node scripts/build-app-libs.mjs",
    "pack:apps": "node scripts/pack-apps.mjs",
    "build:skill-flow": "esbuild src/renderer/skill-flow.tsx --bundle --outfile=dist/renderer/skill-flow.js --platform=browser --format=iife --jsx=automatic --loader:.css=css",
    "build:renderer": "tsc -p src/renderer/tsconfig.json && shx cp src/renderer/styles.css src/renderer/browser.html src/renderer/thinking.html dist/renderer/ && shx cp -r src/renderer/fonts dist/renderer/ && shx cp -r src/renderer/brand dist/renderer/ && node scripts/assemble-home.mjs",
    "build:terminal": "esbuild src/renderer/terminal-renderer.ts --bundle --outfile=dist/renderer/terminal-bundle.js --platform=browser && shx cp node_modules/@xterm/xterm/css/xterm.css src/renderer/terminal.html dist/renderer/",
    "build:monaco": "shx cp -r node_modules/monaco-editor/min/vs dist/renderer/monaco",
    "bench:code-index": "npm run build:main && node dist/main/code-index/benchmark.js",
    "bench:code-index-ab": "npm run build:main && node dist/main/code-index/benchmark-ab.js",
    "start": "electron .",
    "clean:local": "bash scripts/clean-local.sh",
    "postinstall": "electron-rebuild",
    "package:mac": "electron-builder --mac",
    "package:win": "electron-builder --win"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/glyphh-ai/yo-client.git"
  },
  "author": "Glyphh AI",
  "license": "LicenseRef-Proprietary",
  "devDependencies": {
    "@electron/rebuild": "^3.7.0",
    "@types/adm-zip": "^0.5.8",
    "@types/better-sqlite3": "^7.6.13",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.19.17",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.1",
    "@types/ws": "^8.18.1",
    "electron": "^42.5.1",
    "electron-builder": "^25.1.0",
    "esbuild": "^0.25.0",
    "shx": "^0.4.0",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.126",
    "@anthropic-ai/sdk": "^0.110.0",
    "@glyphh/client": "file:../sdk",
    "@google/genai": "^2.10.0",
    "@huggingface/transformers": "^4.1.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/cytoscape": "^3.21.9",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "@xyflow/react": "^12.10.2",
    "adm-zip": "^0.5.17",
    "better-sqlite3": "^12.11.1",
    "chart.js": "^4.5.1",
    "cytoscape": "^3.33.3",
    "cytoscape-dagre": "^2.5.0",
    "dagre": "^0.8.5",
    "dompurify": "^3.2.7",
    "dotenv": "^17.4.2",
    "electron-updater": "^6.8.3",
    "js-yaml": "^4.1.1",
    "koffi": "^3.1.2",
    "kuzu": "^0.11.3",
    "marked": "^14.0.0",
    "monaco-editor": "^0.55.1",
    "node-cron": "^4.2.1",
    "node-pty": "^1.0.0",
    "onnxruntime-node": "^1.24.3",
    "openai": "^6.45.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "three": "^0.184.0",
    "ws": "^8.21.0",
    "zod": "^4.3.6"
  },
  "overrides": {
    "monaco-editor": {
      "dompurify": "^3.4.11"
    },
    "tar": "7.5.16"
  }
}
