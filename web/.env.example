# app/web (SDK-direct web target) — DEV config template. CLIENT-SAFE values only;
# these are injected into the browser by web/serve.mjs. Never put server secrets here.
# Copy to web/.env and fill in for local dev.

# Local server the SDK talks to (prod default is https://api.glyphh.ai).
GLYPHH_SERVER_URL=http://localhost:3001

# Google Web OAuth client ID (public; server verifies the ID token against GOOGLE_CLIENT_IDS).
GLYPHH_GOOGLE_CLIENT_ID=your-web-oauth-client-id.apps.googleusercontent.com

# Marketing site for outbound links.
GLYPHH_WEB_URL=http://localhost:3000

# Port the web target serves on (keep 3002 to match the registered Google OAuth origin).
PORT=3002
